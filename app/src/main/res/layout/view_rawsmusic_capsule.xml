<?xml version="1.0" encoding="utf-8"?>
<com.rawsmusic.ui.widget.CapsuleRootLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/capsule_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginHorizontal="8dp"
    android:layout_marginBottom="8dp"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <com.rawsmusic.ui.widget.NavbarExtension
        android:id="@+id/fold_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <LinearLayout
            android:id="@+id/mini_player"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.cardview.widget.CardView
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/iv_cover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:scrollHorizontally="true"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="歌曲名称" />

                    <TextView
                        android:id="@+id/tv_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:scrollHorizontally="true"
                        android:textColor="#B0FFFFFF"
                        android:textSize="11sp"
                        tools:text="艺术家" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btn_play_pause"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:src="@drawable/ic_play"
                    android:tint="#80FFFFFF" />
            </LinearLayout>

            <com.rawsmusic.ui.widget.CapsuleSeekBar
                android:id="@+id/seek_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </com.rawsmusic.ui.widget.NavbarExtension>

    <com.rawsmusic.ui.widget.NavbarExtension
        android:id="@+id/library_card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/btn_albums"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:text="专辑"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                app:drawableStartCompat="@drawable/ic_album"
                app:drawableTint="#FFFFFF" />

            <TextView
                android:id="@+id/btn_artists"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:text="艺术家"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                app:drawableStartCompat="@drawable/ic_person"
                app:drawableTint="#FFFFFF" />

            <TextView
                android:id="@+id/btn_home_from_library"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:text="主页"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                app:drawableStartCompat="@drawable/ic_home_3_fill"
                app:drawableTint="#FFFFFF" />

        </LinearLayout>
    </com.rawsmusic.ui.widget.NavbarExtension>

    <com.rawsmusic.ui.widget.NavbarExtension
        android:id="@+id/eq_card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/btn_audio_quality"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:text="音质设置"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                app:drawableStartCompat="@drawable/ic_rhythm_fill"
                app:drawableTint="#FFFFFF" />

            <TextView
                android:id="@+id/btn_sound_effect"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:text="音效设置"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                app:drawableStartCompat="@drawable/ic_sound_module_fill"
                app:drawableTint="#FFFFFF" />

            <TextView
                android:id="@+id/btn_usb_dac"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:text="USB DAC 设置"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                app:drawableStartCompat="@drawable/ic_usb_line"
                app:drawableTint="#FFFFFF" />

        </LinearLayout>
    </com.rawsmusic.ui.widget.NavbarExtension>

    <com.rawsmusic.ui.widget.NavbarExtension
        android:id="@+id/settings_card_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="invisible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/btn_settings_detail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:text="设置"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                app:drawableStartCompat="@drawable/ic_settings"
                app:drawableTint="#FFFFFF" />

            <TextView
                android:id="@+id/btn_about_detail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackground"
                android:drawablePadding="12dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="8dp"
                android:text="关于"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                app:drawableStartCompat="@drawable/ic_info"
                app:drawableTint="#FFFFFF" />

        </LinearLayout>
    </com.rawsmusic.ui.widget.NavbarExtension>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/nav_bar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp">

        <!-- 左侧参考线：往外靠，减少内边距 -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_album_center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="4dp" />

        <!-- 右侧参考线：往外靠，减少内边距 -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_play_center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_end="4dp" />

        <LinearLayout
            android:id="@+id/nav_library"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:minWidth="48dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/nav_eq"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintStart_toStartOf="@id/guide_album_center"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <View
                    android:id="@+id/nav_library_bg"
                    android:layout_width="48dp"
                    android:layout_height="35dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_nav_highlight"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iv_nav_library"
                    android:layout_width="31dp"
                    android:layout_height="31dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_function_fill"
                    android:tint="#80FFFFFF" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_eq"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:minWidth="48dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/nav_search"
            app:layout_constraintStart_toEndOf="@id/nav_library"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <View
                    android:id="@+id/nav_eq_bg"
                    android:layout_width="48dp"
                    android:layout_height="35dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_nav_highlight"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iv_nav_eq"
                    android:layout_width="31dp"
                    android:layout_height="31dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_equalizer_line"
                    android:tint="#80FFFFFF" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_search"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:minWidth="48dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/nav_settings"
            app:layout_constraintStart_toEndOf="@id/nav_eq"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <View
                    android:id="@+id/nav_search_bg"
                    android:layout_width="48dp"
                    android:layout_height="35dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_nav_highlight"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iv_nav_search"
                    android:layout_width="31dp"
                    android:layout_height="31dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_search_bold"
                    android:tint="#80FFFFFF" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/nav_settings"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:minWidth="48dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/guide_play_center"
            app:layout_constraintStart_toEndOf="@id/nav_search"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <View
                    android:id="@+id/nav_settings_bg"
                    android:layout_width="48dp"
                    android:layout_height="35dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_nav_highlight"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iv_nav_settings"
                    android:layout_width="31dp"
                    android:layout_height="31dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_home_3_fill"
                    android:tint="#80FFFFFF" />
            </FrameLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.rawsmusic.ui.widget.CapsuleRootLayout>
