<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFFFF"
    android:fitsSystemWindows="true">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="音质设置"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FF1C1B1F"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="72dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFF7F2FA"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#FFE7E0EC">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="采样率"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FF1C1B1F"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_sample_rate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#FF49454F"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderSampleRate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="8"
                        android:stepSize="1"
                        app:thumbColor="#FF6750A4"
                        app:trackColorActive="#FF6750A4"
                        app:trackColorInactive="#FFE7E0EC"
                        app:haloColor="#1A6750A4" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFF7F2FA"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#FFE7E0EC">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="位深度"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FF1C1B1F"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_bit_depth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#FF49454F"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sliderBitDepth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:valueFrom="0"
                        android:valueTo="3"
                        android:stepSize="1"
                        app:thumbColor="#FF6750A4"
                        app:trackColorActive="#FF6750A4"
                        app:trackColorInactive="#FFE7E0EC"
                        app:haloColor="#1A6750A4" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFF7F2FA"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#FFE7E0EC">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="音频输出协议"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FF1C1B1F"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvOutputProtocol"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="#FF49454F"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvOutputDevice"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="#FF8A8690"
                        android:drawablePadding="6dp"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupOutputMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_opensl"
                            style="@style/Widget.Material3.Chip.Suggestion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OpenSL ES"
                            android:textColor="#FF6750A4"
                            app:chipBackgroundColor="#FFF7F2FA"
                            app:chipStrokeColor="#FFE7E0EC"
                            app:chipStrokeWidth="1dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_aaudio"
                            style="@style/Widget.Material3.Chip.Suggestion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AAudio"
                            android:textColor="#FF6750A4"
                            app:chipBackgroundColor="#FFF7F2FA"
                            app:chipStrokeColor="#FFE7E0EC"
                            app:chipStrokeWidth="1dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_direct"
                            style="@style/Widget.Material3.Chip.Suggestion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Direct HiRes"
                            android:textColor="#FF6750A4"
                            app:chipBackgroundColor="#FFF7F2FA"
                            app:chipStrokeColor="#FFE7E0EC"
                            app:chipStrokeWidth="1dp" />

                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFF7F2FA"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#FFE7E0EC">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="回放增益 (ReplayGain)"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FF1C1B1F"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="自动调节音量以平衡不同歌曲间的响度差异"
                        android:textSize="13sp"
                        android:textColor="#FF8A8690"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchNormalization"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="启用回放增益"
                        android:textColor="#FF49454F"
                        app:thumbTint="@color/switch_thumb_color"
                        app:trackTint="@color/switch_track_color" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFF7F2FA"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#FFE7E0EC">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="无缝播放 (Gapless)"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FF1C1B1F"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="预缓存下一首曲目，消除曲目间间隙"
                        android:textSize="13sp"
                        android:textColor="#FF8A8690"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchGapless"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="启用无缝播放"
                        android:textColor="#FF49454F"
                        app:thumbTint="@color/switch_thumb_color"
                        app:trackTint="@color/switch_track_color" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFF7F2FA"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#FFE7E0EC">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="USB DAC"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FF1C1B1F"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="连接 USB DAC 时的播放策略"
                        android:textSize="13sp"
                        android:textColor="#FF8A8690"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchBitPerfect"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="完美比特 (Bit-Perfect)"
                        android:textColor="#FF49454F"
                        app:thumbTint="@color/switch_thumb_color"
                        app:trackTint="@color/switch_track_color"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="不修改 PCM 数据，禁用软件音量，要求设备格式与输入完全匹配"
                        android:textSize="12sp"
                        android:textColor="#FF8A8690"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchHardwareFeatureUnit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="硬件音量控制（实验性）"
                        android:textColor="#FF49454F"
                        app:thumbTint="@color/switch_thumb_color"
                        app:trackTint="@color/switch_track_color"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="启用 USB DAC 硬件静音/音量控制，部分 DAC 可能导致声道不平衡"
                        android:textSize="12sp"
                        android:textColor="#FF8A8690"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_spatial_sound"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="立体声扩展"
                        android:textColor="#FF6750A4"
                        app:strokeColor="#FF6750A4"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
