<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg">

    <!-- 侧边菜单（底层） -->
    <com.rawsmusic.core.ui.widget.SideMenuView
        android:id="@+id/sideMenu"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

    <!-- ===== 统一场景容器（Poweramp 模式） ===== -->
    <com.rawsmusic.core.ui.widget.UnifiedPlayerContainer
        android:id="@+id/unifiedContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="false">

        <!-- ===== 动态背景（所有场景共用） ===== -->
        <com.rawsmusic.core.ui.widget.DynamicCoverBackgroundView
            android:id="@+id/backgroundView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- ===== 主界面常驻封面（流光背景之上，歌曲列表之下） ===== -->
        <com.rawsmusic.core.ui.widget.ImmersiveBackgroundView
            android:id="@+id/mainPersistentCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- ===== 主界面内容 ===== -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/nav_host_fragment"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:defaultNavHost="true"
            app:navGraph="@navigation/nav_main" />

        <!-- ===== 播放页动态封面背景（PLAY 场景可见） ===== -->
        <com.rawsmusic.core.ui.widget.DynamicCoverBackgroundView
            android:id="@+id/playBgView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- ===== 播放页前景内容（横屏：左专辑图+右控制区） ===== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/playLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:fitsSystemWindows="false"
            android:background="@android:color/transparent">

            <ImageView
                android:id="@+id/btnMore"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="28dp"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:elevation="12dp"
                android:src="@drawable/ic_more"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- 横屏：左侧专辑图，居中于左半屏幕 -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivPlayCover"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginVertical="24dp"
                android:elevation="4dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music_note"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@id/guideHalf"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.35"
                app:shapeAppearanceOverlay="@style/CoverShape" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideHalf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.5" />

            <!-- Hi-Res小图标 -->
            <ImageView
                android:id="@+id/ivHiresSmall"
                android:layout_width="48dp"
                android:layout_height="24dp"
                android:adjustViewBounds="true"
                android:scaleType="fitEnd"
                android:elevation="8dp"
                android:src="@drawable/ic_hires_small"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@id/ivPlayCover"
                app:layout_constraintEnd_toEndOf="@id/ivPlayCover"
                android:layout_marginEnd="0dp"
                android:layout_marginBottom="0dp" />

            <FrameLayout
                android:id="@+id/btnPlayModeContainer"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_icon_highlight_container"
                android:clickable="true"
                android:focusable="true"
                android:elevation="8dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/ivPlayCover"
                app:layout_constraintTop_toBottomOf="@id/ivPlayCover"
                android:layout_marginEnd="54dp"
                android:layout_marginTop="4dp">

                <ImageView
                    android:id="@+id/btnPlayMode"
                    android:layout_width="31dp"
                    android:layout_height="31dp"
                    android:layout_gravity="center"
                    android:padding="2dp"
                    android:src="@drawable/ic_order_play_fill"
                    android:tint="#CCFFFFFF" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/btnMoreActionContainer"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_icon_highlight_container"
                android:clickable="true"
                android:focusable="true"
                android:elevation="8dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@id/ivPlayCover"
                app:layout_constraintTop_toTopOf="@id/btnPlayModeContainer"
                android:layout_marginEnd="23dp">

                <ImageView
                    android:id="@+id/btnMoreAction"
                    android:layout_width="31dp"
                    android:layout_height="31dp"
                    android:layout_gravity="center"
                    android:padding="5dp"
                    android:src="@drawable/ic_more_vert"
                    android:tint="#CCFFFFFF" />
            </FrameLayout>

            <!-- 横屏：右侧控制区 -->
            <LinearLayout
                android:id="@+id/playTitleGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp"
                android:gravity="start"
                android:orientation="vertical"
                android:elevation="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/guideHalf"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.45">

                <com.rawsmusic.core.ui.widget.MarqueeTextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="#FFF0EBE8"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.rawsmusic.core.ui.widget.MarqueeTextView
                    android:id="@+id/tvArtist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="start"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="#C0B8B4"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvAlbum"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="marquee"
                    android:gravity="start"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:textColor="#908884"
                    android:textSize="11sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/playControls"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:elevation="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@id/guideHalf"
                app:layout_constraintTop_toBottomOf="@id/playTitleGroup"
                app:layout_constraintWidth_percent="0.45">

                <com.rawsmusic.core.ui.widget.PlayerSeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="match_parent"
                    android:layout_height="22dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvCurrentTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="0:00"
                        android:textColor="#B0A8A4"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvTotalTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0:00"
                        android:textColor="#B0A8A4"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

                <TextView
                    android:id="@+id/audioInfoCapsule"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"
                    android:background="@drawable/capsule_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="center"
                    android:maxWidth="260dp"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:paddingHorizontal="10dp"
                    android:textColor="#B0FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/btnPreviousContainer"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@drawable/bg_icon_highlight_container"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/btnPrevious"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:padding="6dp"
                            android:src="@drawable/ic_rewind_fill" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btnPlayPauseContainer"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@drawable/bg_icon_highlight_container"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/btnPlayPause"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:padding="2dp"
                            android:src="@drawable/ic_play"
                            android:tint="@color/accent" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/btnNextContainer"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@drawable/bg_icon_highlight_container"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/btnNext"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:padding="6dp"
                            android:src="@drawable/ic_speed_fill" />
                    </FrameLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/playActionBar"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnAudioQuality"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:src="@drawable/ic_equalizer_bars"
                        android:tint="#B0FFFFFF" />

                </LinearLayout>

            </LinearLayout>

            <!-- 歌曲页元数据卡片 -->
            <com.rawsmusic.core.ui.widget.MetadataCardView
                android:id="@+id/playMetadataCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="76dp"
                android:layout_marginEnd="20dp"
                android:elevation="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ===== 歌词页动态封面背景 ===== -->
        <com.rawsmusic.core.ui.widget.DynamicCoverBackgroundView
            android:id="@+id/lyricBgView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- ===== 歌词内容层（横屏：左侧封面+右侧歌词） ===== -->
        <FrameLayout
            android:id="@+id/lyricContentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:visibility="gone">

            <!-- 横屏歌词容器 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingTop="40dp"
                android:paddingBottom="60dp">

                <!-- 左侧封面（放大） -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivLyricCover"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:layout_marginEnd="16dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_music_note"
                    app:shapeAppearanceOverlay="@style/CoverShape" />

                <!-- 右侧歌词 -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="3">

                    <com.rawsmusic.core.ui.widget.LyricView
                        android:id="@+id/lyricView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="16dp" />

                </FrameLayout>

            </LinearLayout>

            <!-- 底部控制栏 -->
            <LinearLayout
                android:id="@+id/lyricControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:id="@+id/btnPreviousLyric"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_rewind_fill"
                    android:tint="#B0FFFFFF" />

                <ImageView
                    android:id="@+id/btnPlayPauseLyric"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginHorizontal="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/ic_play"
                    android:tint="@color/accent" />

                <ImageView
                    android:id="@+id/btnNextLyric"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_speed_fill"
                    android:tint="#B0FFFFFF" />

            </LinearLayout>

        </FrameLayout>

        <!-- ===== 歌词页顶部主层 ===== -->
        <LinearLayout
            android:id="@+id/lyricMainLayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:orientation="horizontal"
            android:gravity="center_vertical|end"
            android:paddingHorizontal="16dp"
            android:paddingTop="28dp"
            android:paddingBottom="16dp"
            android:elevation="12dp"
            android:background="@drawable/bg_lyric_header_gradient">

            <ImageView
                android:id="@+id/btnMoreLyric"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_more"
                android:tint="#B0FFFFFF" />

        </LinearLayout>

        <!-- ===== 歌词页元数据卡片 ===== -->
        <com.rawsmusic.core.ui.widget.MetadataCardView
            android:id="@+id/lyricMetadataCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="80dp"
            android:layout_marginEnd="20dp"
            android:elevation="24dp" />

        <!-- ===== 底部迷你栏 ===== -->
        <com.rawsmusic.core.ui.widget.MiniPlayerView
            android:id="@+id/miniPlayerBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp" />

        <!-- ===== 音效/EQ 面板（右滑进入，横屏布局） ===== -->
        <LinearLayout
            android:id="@+id/effectsPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:layout_marginTop="54dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:orientation="vertical"
            android:elevation="8dp"
            android:visibility="gone"
            android:alpha="0"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/tvEffectsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="音效"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="参量均衡器"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchPeqEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/peqDetailRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp">

                <TextView
                    android:id="@+id/tvPeqPresetName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#99FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvPeqPreamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/peqBarsContainer"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:gravity="bottom|center_horizontal"
                android:layout_marginBottom="12dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FFFFFF"
                android:layout_marginVertical="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="立体声扩展"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchSpatialEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />

            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderSpatialStrength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:stepSize="10"
                android:valueFrom="0"
                android:valueTo="1000" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FFFFFF"
                android:layout_marginVertical="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="低音增强"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderBassBoost"
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:valueFrom="0"
                    android:valueTo="100" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FFFFFF"
                android:layout_marginVertical="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="响度增强"
                    android:textColor="#CCFFFFFF"
                    android:textSize="13sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderLoudnessEnhance"
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:valueFrom="0"
                    android:valueTo="100" />

            </LinearLayout>

        </LinearLayout>

        <!-- ===== 元数据详情界面 ===== -->
        <FrameLayout
            android:id="@+id/metadataDetailLayer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:elevation="80dp">

            <View
                android:id="@+id/metadataDetailBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#E6171412" />

            <LinearLayout
                android:id="@+id/metadataDetailContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="36dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnMetadataBack"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:src="@drawable/ic_back"
                        android:tint="#B0FFFFFF" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="6dp"
                        android:src="@drawable/ic_info_green" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="元数据"
                        android:textColor="#FF4CAF50"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="12dp"
                    android:paddingBottom="30dp">

                    <LinearLayout
                        android:id="@+id/metadataDetailList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </ScrollView>

            </LinearLayout>

        </FrameLayout>

        <!-- ===== 全屏专辑图查看器 ===== -->
        <FrameLayout
            android:id="@+id/fullCoverViewer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FF000000"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:elevation="100dp">

            <ImageView
                android:id="@+id/btnFullCoverBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="top|start"
                android:layout_marginStart="12dp"
                android:layout_marginTop="28dp"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_back"
                android:tint="#B0FFFFFF"
                android:elevation="2dp" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivFullCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="60dp"
                android:layout_marginVertical="80dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_music_note"
                app:shapeAppearanceOverlay="@style/CoverShape" />

        </FrameLayout>

        <include
            android:id="@+id/songActionSheetContainer"
            layout="@layout/sheet_song_actions"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </com.rawsmusic.core.ui.widget.UnifiedPlayerContainer>

</FrameLayout>
