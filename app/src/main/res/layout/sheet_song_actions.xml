<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/songActionOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:visibility="gone"
    android:clickable="true"
    android:focusable="true"
    android:elevation="60dp">

    <LinearLayout
        android:id="@+id/songActionSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="@drawable/bg_song_action_sheet"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        android:paddingHorizontal="20dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="#33FFFFFF" />

        <TextView
            android:id="@+id/actionAddToPlaylist"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="将此曲添加至歌单"
            android:textColor="#E0FFFFFF"
            android:textSize="15sp"
            android:paddingStart="8dp"
            android:drawableStart="@drawable/ic_play_list_fill"
            android:drawableTint="#E0FFFFFF"
            android:drawablePadding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/actionAddToQueue"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="添加至队列"
            android:textColor="#E0FFFFFF"
            android:textSize="15sp"
            android:paddingStart="8dp"
            android:drawableStart="@drawable/ic_play_list_add_fill"
            android:drawableTint="#E0FFFFFF"
            android:drawablePadding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/actionEditMetadata"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="编辑元数据"
            android:textColor="#E0FFFFFF"
            android:textSize="15sp"
            android:paddingStart="8dp"
            android:drawableStart="@drawable/ic_file_edit_fill"
            android:drawableTint="#E0FFFFFF"
            android:drawablePadding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/actionAlbumInfo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="专辑所属"
            android:textColor="#E0FFFFFF"
            android:textSize="15sp"
            android:paddingStart="8dp"
            android:drawableStart="@drawable/ic_album_fill"
            android:drawableTint="#E0FFFFFF"
            android:drawablePadding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/actionMetadata"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="元数据"
            android:textColor="#E0FFFFFF"
            android:textSize="15sp"
            android:paddingStart="8dp"
            android:drawableStart="@drawable/ic_file_info_fill"
            android:drawableTint="#E0FFFFFF"
            android:drawablePadding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/actionSleepTimer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="睡眠定时"
            android:textColor="#E0FFFFFF"
            android:textSize="15sp"
            android:paddingStart="8dp"
            android:drawableStart="@drawable/ic_moon_fill"
            android:drawableTint="#E0FFFFFF"
            android:drawablePadding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/actionDelete"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:text="删除此曲"
            android:textColor="#FFFF5252"
            android:textSize="15sp"
            android:paddingStart="8dp"
            android:drawableStart="@drawable/ic_delete_bin_6_fill"
            android:drawableTint="#FFFF5252"
            android:drawablePadding="12dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

        <LinearLayout
            android:id="@+id/actionCoverRow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/actionChangeCover"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:text="修改此曲专辑图"
                android:textColor="#E0FFFFFF"
                android:textSize="15sp"
                android:paddingStart="8dp"
                android:drawableStart="@drawable/ic_edit_box_fill"
                android:drawableTint="#E0FFFFFF"
                android:drawablePadding="12dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <TextView
                android:id="@+id/btnCoverModify"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="4dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="修改"
                android:textColor="#B0FFFFFF"
                android:textSize="11sp"
                android:background="@drawable/capsule_bg"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnCoverRestore"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="恢复"
                android:textColor="#66FFFFFF"
                android:textSize="11sp"
                android:background="@drawable/capsule_bg"
                android:clickable="false"
                android:enabled="false" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
