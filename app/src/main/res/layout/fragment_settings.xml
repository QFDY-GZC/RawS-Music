<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFFFF"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FF1C1B1F"
        android:layout_marginBottom="24dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="160dp">

            <!-- 词幕（Lyricon）设置 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFF7F2FA"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#FFE7E0EC">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="词幕（Lyricon）"
                            android:textSize="16sp"
                            android:textColor="#FF1C1B1F" />

                        <TextView
                            android:id="@+id/tvLyriconStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="未启用"
                            android:textSize="12sp"
                            android:textColor="#FF79747E" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="向系统状态栏推送歌词显示。需要安装词幕中央服务（Xposed模块或LocalCentralApp）才能连接。"
                        android:textSize="12sp"
                        android:textColor="#FF79747E"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchLyriconEnabled"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="启用词幕推送"
                        android:textColor="#FF49454F"
                        app:thumbTint="#FF6750A4"
                        app:trackTint="#FFD0BCFF" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchLyriconTranslation"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="显示翻译"
                        android:textColor="#FF49454F"
                        app:thumbTint="#FF6750A4"
                        app:trackTint="#FFD0BCFF" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchLyriconRoma"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="显示罗马音"
                        android:textColor="#FF49454F"
                        app:thumbTint="#FF6750A4"
                        app:trackTint="#FFD0BCFF" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 音质设置 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFF7F2FA"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#FFE7E0EC">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="音质设置"
                        android:textSize="16sp"
                        android:textColor="#FF1C1B1F"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAudioSettings"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="进入音质设置"
                        android:textColor="#FF6750A4"
                        app:backgroundTint="#FFEDDCFE"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 扫描文件夹 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFF7F2FA"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#FFE7E0EC">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="扫描文件夹"
                        android:textSize="16sp"
                        android:textColor="#FF1C1B1F"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvScanPathsHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="未指定则扫描全部音乐"
                        android:textSize="12sp"
                        android:textColor="#FF79747E"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:id="@+id/scanPathsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddScanPath"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="添加文件夹"
                        android:textColor="#FF6750A4"
                        app:backgroundTint="#FFEDDCFE"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 重新扫描 -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#FFF7F2FA"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#FFE7E0EC">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scan_settings"
                        android:textSize="16sp"
                        android:textColor="#FF1C1B1F"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRescan"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/rescan_library"
                        android:textColor="#FF6750A4"
                        app:backgroundTint="#FFEDDCFE"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
